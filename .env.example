# =====================================================================
# FloodAI Platform Root Environment Template
# Copy to backend/.env and ml_model/.env for local run
# =====================================================================

# Server & Network
PORT=5000
ML_PORT=8000
ML_API_URL=http://localhost:8001
ML_SERVICE_URL=http://localhost:8000
NODE_ENV=production
CORS_ORIGIN=https://floodai-frontend.onrender.com

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/flood_prediction?retryWrites=true&w=majority

# Microservice Networking
INTERNAL_SERVICE_SECRET=your_secure_internal_service_secret_here
INTERNAL_SERVICE_KEY=your_secure_internal_service_secret_here
STRICT_INTERNAL_AUTH=false

# Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# AI Threat Intelligence Engine (Groq LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY2=your_groq_api_key_here

# Firebase Cloud Messaging (Web Push Notifications)
FIREBASE_PROJECT_ID=floodai-24a0f
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVER_KEY=your_firebase_server_key_here

# Transactional Email (Brevo SMTP & Sendinblue)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_FROM_EMAIL=alerts@floodai.org
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=alerts@floodai.org
BREVO_SENDER_NAME=FloodAI Threat Intelligence

# SMS Provider Abstraction (Twilio / Brevo SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
BREVO_SMS_SENDER=FloodAI

# Atmospheric Telemetry
OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_WEATHER_API_KEY=your_openweather_api_key_here
