# =====================================================================
# FloodAI ML Prediction Microservice Environment Template
# Copy this file to ml_model/.env for local service execution
# =====================================================================

# Service Port and Host
PORT=8000
ML_HOST=0.0.0.0
ML_DEBUG=false

# Groq LLM Threat Synthesis API
GROQ_API_KEY=your_groq_api_key_here

# Service-to-Service Security
INTERNAL_SERVICE_SECRET=your_secure_internal_service_secret_here
STRICT_INTERNAL_AUTH=false

# Allowed Origins (Comma-separated or *)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000
