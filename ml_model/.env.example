# =====================================================================
# FloodAI ML Prediction Microservice Environment Template
# Copy this file to ml_model/.env for local service execution
# =====================================================================

# Service Port and Host
PORT=8000
ML_PORT=8000
ML_HOST=0.0.0.0
ML_DEBUG=false

# Groq LLM Threat Synthesis API
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY2=your_groq_api_key_here

# Service-to-Service Security
INTERNAL_SERVICE_SECRET=your_secure_internal_service_secret_here
INTERNAL_SERVICE_KEY=your_secure_internal_service_secret_here
STRICT_INTERNAL_AUTH=false

# Allowed Origins (Comma-separated or *)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Database & Telemetry (Optional for standalone analytics)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/flood_prediction?retryWrites=true&w=majority
OPENWEATHER_API_KEY=your_openweather_api_key_here
