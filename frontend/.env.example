# =====================================================================
# FloodAI Frontend Client Configuration Template
# Frontend uses client-safe public keys only. Never store private secrets here.
# =====================================================================

# Backend API Endpoint
API_BASE_URL=http://localhost:5000/api

# ML Service Direct Endpoint (Optional for direct browser simulations)
ML_SERVICE_URL=http://localhost:8000

# OpenWeather Public Client Key (Optional fallback if not proxied via backend)
OPENWEATHER_CLIENT_KEY=your_openweather_public_client_key_here

# Firebase Web Push VAPID Public Key (Safe for client browsers)
FIREBASE_VAPID_KEY=your_firebase_public_vapid_key_here
